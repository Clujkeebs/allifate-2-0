# =============================================================================
# Virlo — environment variables
#
# Copy to `.env.local` for local dev (Vite reads it automatically) and add the
# same keys in Vercel → Project → Settings → Environment Variables for prod.
# Variables prefixed with VITE_ are bundled into the client; everything else
# is server-only (Vercel functions + Supabase edge functions).
# =============================================================================

# --- Public site URL (used for OAuth + Stripe redirects) ---------------------
PUBLIC_SITE_URL=https://virlo.ai

# --- Supabase ----------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only — used by Vercel API + Stripe webhook. NEVER expose to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Claude) ------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional override — defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe Price IDs — required for /api/create-checkout to map plan → price.
# Create one product per tier with a monthly + annual recurring price.
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# --- Zernio (bundled multi-platform OAuth + posting) --------------------------
# Optional. When set, the SettingsPage shows a single "Connect all" action.
# When unset, the app falls back to per-platform direct OAuth.
VITE_ZERNIO_API_KEY=
VITE_ZERNIO_BASE_URL=https://api.zernio.io/v1
VITE_ZERNIO_REFERRAL_CODE=
ZERNIO_WEBHOOK_SECRET=

# --- AI image generation (pick one provider) ---------------------------------
VITE_IMAGE_GEN_PROVIDER=replicate
VITE_REPLICATE_API_KEY=
VITE_OPENAI_API_KEY=
VITE_STABILITY_API_KEY=

# --- ElevenLabs (voiceover) --------------------------------------------------
ELEVENLABS_API_KEY=

# --- Stock media APIs --------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Zapier integration ------------------------------------------------------
# Required only if you advertise the /api/zapier-webhook endpoint.
ZAPIER_WEBHOOK_SECRET=
ZAPIER_GLOBAL_API_KEY=

# --- Per-platform direct OAuth (used only when Zernio is not configured) ------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
