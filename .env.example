# Virlo — Environment Variables
# Copy this file to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ElevenLabs (voiceover)
ELEVENLABS_API_KEY=

# Stock Media APIs
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Platform OAuth — Vite-prefixed (client-side, used in SettingsPage)
VITE_TIKTOK_CLIENT_KEY=
VITE_INSTAGRAM_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_TWITTER_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=
VITE_FACEBOOK_CLIENT_ID=
VITE_PINTEREST_CLIENT_ID=
VITE_SNAPCHAT_CLIENT_ID=

# Platform OAuth — server-side secrets (used in oauth-exchange Edge Function)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# App origin (used by OAuth exchange edge function)
APP_ORIGIN=http://localhost:5173

# ── AI Image Generation ─────────────────────────────────────
# Provider: replicate (Flux), openai (DALL-E 3), or stability (SD 3.5)
VITE_IMAGE_GEN_PROVIDER=replicate
VITE_REPLICATE_API_KEY=
VITE_OPENAI_API_KEY=
VITE_STABILITY_API_KEY=
# Server-side: used by the generate-images edge function
REPLICATE_API_KEY=
OPENAI_API_KEY=
STABILITY_API_KEY=
IMAGE_GEN_PROVIDER=replicate

# ── Zerio — Social Media API Aggregator ─────────────────────
# Get your API keys from https://zerio.io/dashboard
# When configured, Zerio handles all 8 platform OAuth connections
# through a single "Connect All Platforms" flow.
VITE_ZERIO_API_KEY=
VITE_ZERIO_BASE_URL=https://api.zerio.io/v1
# Revenue-share / affiliate tracking code (contact Zerio for yours)
VITE_ZERIO_REFERRAL_CODE=
# Webhook secret for incoming Zerio events (post status, analytics)
ZERIO_WEBHOOK_SECRET=

# ── Zapier integration ─────────────────────────────────────────
ZAPIER_WEBHOOK_SECRET=
ZAPIER_GLOBAL_API_KEY=
